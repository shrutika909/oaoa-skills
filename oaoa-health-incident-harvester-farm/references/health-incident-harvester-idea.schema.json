{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oaoa.health-incident-harvester-idea.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "title",
    "idea",
    "why_hard",
    "novelty_check",
    "proposed_test_shape",
    "anti_cheat_notes",
    "levers",
    "do_not_mention"
  ],
  "properties": {
    "schema": {"const": "oaoa.health-incident-harvester-idea.v1"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 100},
    "idea": {"type": "string", "minLength": 80, "maxLength": 3000},
    "why_hard": {"type": "string", "minLength": 40, "maxLength": 2000},
    "novelty_check": {"type": "string", "minLength": 20, "maxLength": 1200},
    "proposed_test_shape": {"type": "string", "minLength": 40, "maxLength": 2000},
    "anti_cheat_notes": {"type": "string", "minLength": 40, "maxLength": 2000},
    "levers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$"},
          "reason": {"type": "string", "minLength": 10, "maxLength": 300}
        }
      }
    },
    "do_not_mention": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 2, "maxLength": 120}
    }
  }
}
